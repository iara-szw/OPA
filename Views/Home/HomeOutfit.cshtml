@{
ViewData["Title"] = "HomeOutfits";
}


<div class="masonry-container">
@foreach (var outfit in Model.OrderBy(o => o.Id))
{
<div class="masonry-item">
<img src="/img/example.jpg" alt="Outfit image" />
<div class="info">
<h3>@outfit.Name</h3>
<p>ID: @outfit.Id</p>
</div>
</div>
}
</div>


<style>
.masonry-container {
column-count: 3;
column-gap: 15px;
width: 100%;
}


.masonry-item {
break-inside: avoid;
margin-bottom: 15px;
position: relative;
overflow: hidden;
border-radius: 10px;
}


.masonry-item img {
width: 100%;
display: block;
border-radius: 10px;
}


.info {
padding: 10px;
background: #fff;
}


@media (max-width: 900px) {
.masonry-container {
column-count: 2;
}
}


@media (max-width: 600px) {
.masonry-container {
column-count: 1;
}
}
</style>