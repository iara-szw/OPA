    <head>
    <title>@ViewBag.Prenda.Modelo</title>
    <link rel="stylesheet" href="~/css/prenda.css" asp-append-version="true" />
</head>

<div class="descripcionPrenda">
<img src="/img/@ViewBag.Prenda.foto">
<div class="textoPrenda">
<p>@ViewBag.Prenda.Tipo</p>
<p>@ViewBag.Prenda.Modelo</p>
<p>@ViewBag.Prenda.descripcion</p>
<p>@ViewBag.Prenda.Precio</p>
</div>
</div>



@if(ViewBag.Usuario==true){

    if(!ViewBag.Poseido){
        <form action='@Url.Action("GuardarCarrito","Compra")'>
             <input type="hidden" name="idPrenda" value=@ViewBag.Prenda.IdPrenda>
             <input type="submit" name="Guardar en el carrito">

        </form>
    }else{
        <h2>Esta prenda ya esta en tu armario</h2>
    }
    if(!ViewBag.Deseado){
        <form action='@Url.Action("agregarDeseado","Comprador")' >
             <input type="hidden" name="idPrenda" value=@ViewBag.Prenda.IdPrenda>
             <input type="image" src="foto.png">
        </form>
    }else{
        <h2>Esta prenda ya esta en tus deseados</h2>
    }
    if(ViewBag.estaEnCarrito==true)
{
            <h2>Esta prenda ya esta en tu carrito</h2>

}}else{
    <p>Tienes que iniciar sesion para agregar prendas a tu carrito/deseados</p>
}