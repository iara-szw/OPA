<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OPA - Buscador</title>

    <style>
        :root{
            --pink:#ff1874;
            --dark:#0b0b0b;
            --muted:#bdbdbd;
            --card-shadow: 0 6px 18px rgba(10,10,10,0.06);
            --outline-color:#222;
        }

        *{box-sizing:border-box}
        body{font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial; margin:0; color:#111; background:#fff; -webkit-font-smoothing:antialiased}
        img{max-width:100%; display:block}

        .topbar{
            display:flex;
            align-items:center;
            gap:18px;
            padding:18px 28px;
            background:linear-gradient(90deg,var(--pink) 0%, rgba(0,0,0,0.7) 35%);
            color:white;
        }
        .topbar .logo{
            background:white;
            color:var(--pink);
            padding:8px 12px;
            border-radius:8px;
            font-weight:700;
            width:56px;
            height:36px;
            display:flex;
            align-items:center;
            justify-content:center;
        }
        .search-wrap{flex:1; display:flex; align-items:center; justify-content:center}
        .search{
            width:70%;
            max-width:720px;
            display:flex;
            align-items:center;
            background:white;
            border-radius:999px;
            padding:6px 12px;
            gap:8px;
        }
        .search input{
            border:0; outline:none; flex:1; padding:10px; font-size:14px;
        }
        .top-icons{display:flex; gap:14px; align-items:center}
        .icon-btn{width:36px; height:36px; border-radius:8px; background:rgba(255,255,255,0.12); display:flex; align-items:center; justify-content:center}

        .container{max-width:1200px; margin:26px auto; padding:0 20px}
        h1{ text-align:center; margin:8px 0 22px; letter-spacing:1px}
        .controls{display:flex; justify-content:center; gap:12px; margin-bottom:18px; align-items:center; flex-wrap:wrap}
        .btn{
            padding:10px 14px; border-radius:10px; border:1px solid var(--outline-color); background:white; cursor:pointer; font-weight:600;
        }
        .select{
            padding:8px 12px; border-radius:10px; border:1px solid var(--outline-color); background:white;
        }

        .grid{
            display:grid;
            grid-template-columns: repeat(4, 1fr);
            gap:18px;
            margin-bottom:22px;
        }
        .card{
            background:#fff; border-radius:10px; overflow:hidden; box-shadow:var(--card-shadow); display:flex; flex-direction:column; align-items:center; padding:12px;
        }
        .card .thumb{ width:100%; padding-top:100%; position:relative; border-radius:8px; background:#f3f3f3; overflow:hidden}
        .card .thumb img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover}
        .card .name{ margin-top:12px; color:var(--muted); font-size:13px; text-align:center; min-height:36px}

        .load-more{ display:block; margin:12px auto 80px auto; padding:10px 20px; border-radius:8px; border:1px solid var(--outline-color); background:white; cursor:pointer }

        .bottom-gradient{ height:120px; background: linear-gradient(180deg, rgba(0,0,0,0) 0%, var(--dark) 50%, var(--pink) 100%); margin-top:32px }

        .filters-panel{
            position:fixed; top:80px; right:28px; width:720px; max-width:calc(100% - 32px); background:#fff; border-radius:12px; box-shadow: 0 18px 50px rgba(0,0,0,0.25);
            z-index:1200; padding:20px; display:none; border:1px solid rgba(0,0,0,0.06)
        }
        .filters-panel.open{ display:block }
        .filters-grid{ display:grid; grid-template-columns: repeat(4, 1fr); gap:16px }
        .filter-column h4{ margin:0 0 10px 0; font-size:13px}
        .checkbox{ display:flex; align-items:center; gap:8px; margin-bottom:8px; font-size:13px}
        .checkbox input{ width:16px; height:16px }
        .colors { display:flex; gap:8px; flex-wrap:wrap }
        .color-swatch{ width:28px; height:28px; border-radius:50%; border:2px solid #fff; box-shadow:0 2px 6px rgba(0,0,0,0.12); cursor:pointer; display:inline-block; outline:2px solid transparent }
        .color-swatch.selected{ outline:3px solid #111 }

        .panel-actions{ display:flex; justify-content:space-between; margin-top:12px }
        .small-btn{ padding:8px 10px; border-radius:8px; border:1px solid var(--outline-color); background:#fafafa; cursor:pointer; }

        @@media (max-width:1000px){
            .grid{ grid-template-columns: repeat(3,1fr) }
            .filters-panel{ right:16px; top:76px; width:680px }
        }
        @@media (max-width:800px){
            .grid{ grid-template-columns: repeat(2,1fr) }
            .filters-panel{ position:fixed; left:10px; right:10px; top:90px; width:auto }
        }
        @@media (max-width:480px){
            .grid{ grid-template-columns: 1fr }
            .search{ width:92% }
            .filters-panel{ top:100px; padding:14px }
            .filters-grid{ grid-template-columns: 1fr 1fr; }
        }

        .muted{ color:var(--muted) }
        .sr-only{ position:absolute; left:-9999px; top:auto; width:1px; height:1px; overflow:hidden; }
    </style>
</head>
<body>

    <header class="topbar" role="banner">
        <div class="logo">OPA</div>

        <div class="search-wrap" role="search">
            <div class="search" aria-label="Buscador de productos">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 21l-4.35-4.35" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="11" cy="11" r="6" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <input id="globalSearch" type="search" placeholder="Buscar" autocomplete="off" />
                <button class="icon-btn" onclick="document.getElementById('globalSearch').focus()" title="Buscar">
                    🔎
                </button>
            </div>
        </div>

        <div class="top-icons" aria-hidden="true">
            <div class="icon-btn" title="Carrito">🛒</div>
            <div class="icon-btn" title="Menú">☰</div>
        </div>
    </header>

    <main class="container" role="main">
        <h1>EXPLORAR</h1>

        <div class="controls" role="toolbar" aria-label="Controles de la vista">
            <button id="btnFilters" class="btn" aria-haspopup="true" aria-expanded="false">Filtros ▾</button>

            <select id="selectSort" class="select" aria-label="Ordenar por">
                <option value="name-asc">Ordenar por nombre A–Z</option>
                <option value="name-desc">Nombre Z–A</option>
                <option value="price-asc">Precio menor a mayor</option>
                <option value="price-desc">Precio mayor a menor</option>
                <option value="new-desc">Más nuevo</option>
                <option value="new-asc">Más viejo</option>
            </select>
        </div>

        <section id="productsGrid" class="grid" aria-live="polite"></section>

        <button id="btnLoadMore" class="load-more">CARGAR MÁS</button>
    </main>

    <aside id="filtersPanel" class="filters-panel" aria-hidden="true" role="dialog" aria-label="Filtros">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px">
            <strong>Filtros</strong>
            <button id="closeFilters" class="small-btn">Cerrar ✕</button>
        </div>

        <div class="filters-grid">
            <div class="filter-column">
                <h4>PRENDAS</h4>
                <label class="checkbox"><input type="checkbox" data-filter-group="prendas" value="Remeras" /> Remeras</label>
                <label class="checkbox"><input type="checkbox" data-filter-group="prendas" value="Pantalones" /> Pantalones</label>
                <label class="checkbox"><input type="checkbox" data-filter-group="prendas" value="Chombas" /> Chombas</label>
                <label class="checkbox"><input type="checkbox" data-filter-group="prendas" value="Buzos" /> Buzos</label>
                <label class="checkbox"><input type="checkbox" data-filter-group="prendas" value="Shorts" /> Shorts</label>
                <label class="checkbox"><input type="checkbox" data-filter-group="prendas" value="Vestidos" /> Vestidos</label>
                <label class="checkbox"><input type="checkbox" data-filter-group="prendas" value="Polleras" /> Polleras</label>
                <label class="checkbox"><input type="checkbox" data-filter-group="prendas" value="Bermudas" /> Bermudas</label>
                <label class="checkbox"><input type="checkbox" data-filter-group="prendas" value="Otros" /> Otros</label>
            </div>

            <div class="filter-column">
                <h4>ESTILO</h4>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px;">
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Casual" /> Casual</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Sport" /> Sport</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Formal" /> Formal</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Western" /> Western</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Minimalista" /> Minimalista</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Old Money" /> Old Money</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Colorido" /> Colorido</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Creativo" /> Creativo</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Vintage" /> Vintage</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Gótico" /> Gótico</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Urbano" /> Urbano</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Punk" /> Punk</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Romántico" /> Romántico</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Grunge" /> Grunge</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Bohemio" /> Bohemio</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Hip Hop" /> Hip Hop</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Preppy" /> Preppy</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Skater" /> Skater</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Clásico" /> Clásico</label>
                    <label class="checkbox"><input type="checkbox" data-filter-group="estilo" value="Glam" /> Glam</label>
                </div>

                <div style="margin-top:8px">
                    <button class="small-btn">+ Proponer más estilos</button>
                </div>
            </div>

            <div class="filter-column">
                <h4>TEMPORADA</h4>
                <label class="checkbox"><input type="checkbox" data-filter-group="temporada" value="Verano" /> Verano</label>
                <label class="checkbox"><input type="checkbox" data-filter-group="temporada" value="Primavera" /> Primavera</label>
                <label class="checkbox"><input type="checkbox" data-filter-group="temporada" value="Otoño" /> Otoño</label>
                <label class="checkbox"><input type="checkbox" data-filter-group="temporada" value="Invierno" /> Invierno</label>
            </div>

            <div class="filter-column">
                <h4>COLORES</h4>
                <div class="colors" id="colorSwatches">
                </div>
            </div>
        </div>

        <div class="panel-actions">
            <button id="clearFilters" class="small-btn">Limpiar filtros</button>
            <div style="display:flex; gap:8px">
                <button id="applyFilters" class="btn">Aplicar</button>
            </div>
        </div>
    </aside>

    <div class="bottom-gradient" aria-hidden="true"></div>

    <script>
        const PRODUCTS_MASTER = [
            { id:1, name:"Remera Black Sun", price: 2200, date: "2025-11-10", prendas:["Remeras"], estilo:["Urbano","Grunge"], temporada:["Verano"], color:"Negro", img:"https://picsum.photos/seed/1/800/800" },
            { id:2, name:"Buzo Cozy", price: 5400, date: "2025-10-12", prendas:["Buzos"], estilo:["Casual"], temporada:["Invierno"], color:"Beige", img:"https://picsum.photos/seed/2/800/800" },
            { id:3, name:"Pantalón Cargo Verde", price: 4200, date: "2025-09-20", prendas:["Pantalones"], estilo:["Skater","Casual"], temporada:["Otoño"], color:"Verde", img:"https://picsum.photos/seed/3/800/800" },
            { id:4, name:"Vestido Milano", price: 6500, date: "2025-10-01", prendas:["Vestidos"], estilo:["Formal","Glam"], temporada:["Primavera"], color:"Rosa", img:"https://picsum.photos/seed/4/800/800" },
            { id:5, name:"Shorts Lino", price: 2800, date: "2025-06-03", prendas:["Shorts"], estilo:["Minimalista"], temporada:["Verano"], color:"Beige", img:"https://picsum.photos/seed/5/800/800" },
            { id:6, name:"Chomba Classic", price: 3300, date: "2025-08-18", prendas:["Chombas"], estilo:["Preppy","Clásico"], temporada:["Primavera"], color:"Blanco", img:"https://picsum.photos/seed/6/800/800" },
            { id:7, name:"Bermuda Army", price: 2600, date: "2025-07-28", prendas:["Bermudas"], estilo:["Casual"], temporada:["Verano"], color:"Verde", img:"https://picsum.photos/seed/7/800/800" },
            { id:8, name:"Pollera Denim", price: 3600, date: "2025-09-01", prendas:["Polleras"], estilo:["Urbano"], temporada:["Otoño"], color:"Azul", img:"https://picsum.photos/seed/8/800/800" },
            { id:9, name:"Buzo 89 Black", price: 4900, date: "2025-11-05", prendas:["Buzos"], estilo:["Skater"], temporada:["Invierno"], color:"Negro", img:"https://picsum.photos/seed/9/800/800" },
            { id:10, name:"Remera Minimal Off", price: 2100, date: "2025-05-12", prendas:["Remeras"], estilo:["Minimalista"], temporada:["Primavera"], color:"Blanco", img:"https://picsum.photos/seed/10/800/800" },
            { id:11, name:"Jeans Dark Wash", price: 5200, date: "2025-07-02", prendas:["Pantalones"], estilo:["Casual"], temporada:["Invierno"], color:"Azul", img:"https://picsum.photos/seed/11/800/800" },
            { id:12, name:"Polera Crop", price: 2400, date: "2025-04-25", prendas:["Remeras"], estilo:["Colorido"], temporada:["Verano"], color:"Fucsia", img:"https://picsum.photos/seed/12/800/800" },
            { id:13, name:"Camisa Linen", price: 4100, date: "2025-03-15", prendas:["Remeras"], estilo:["Formal"], temporada:["Verano"], color:"Beige", img:"https://picsum.photos/seed/13/800/800" },
            { id:14, name:"Sweater Milano Green", price: 5600, date: "2025-11-08", prendas:["Buzos"], estilo:["Old Money"], temporada:["Invierno"], color:"Verde", img:"https://picsum.photos/seed/14/800/800" },
            { id:15, name:"Jeans Wide Leg", price: 4800, date: "2025-02-12", prendas:["Pantalones"], estilo:["Vintage"], temporada:["Otoño"], color:"Azul", img:"https://picsum.photos/seed/15/800/800" },
            { id:16, name:"Hoodie Warm Cream", price: 5000, date: "2025-11-11", prendas:["Buzos"], estilo:["Casual"], temporada:["Invierno"], color:"Beige", img:"https://picsum.photos/seed/16/800/800" }
        ];

        const COLOR_PALETTE = [
            { name:"Rojo", hex:"#e53935" },
            { name:"Verde", hex:"#2e7d32" },
            { name:"Amarillo", hex:"#fdd835" },
            { name:"Celeste", hex:"#4fc3f7" },
            { name:"Cyan", hex:"#00acc1" },
            { name:"Rosa", hex:"#ec407a" },
            { name:"Marrón", hex:"#8d6e63" },
            { name:"Fucsia", hex:"#d81b60" },
            { name:"Beige", hex:"#d7ccc8" },
            { name:"Negro", hex:"#111111" },
            { name:"Blanco", hex:"#ffffff" }
        ];

        let state = {
            products: [...PRODUCTS_MASTER],
            visibleCount: 12,
            filters: {
                prendas: new Set(),
                estilo: new Set(),
                temporada: new Set(),
                colores: new Set()
            },
            searchQuery: "",
            sort: "name-asc"
        };

        const productsGrid = document.getElementById('productsGrid');
        const btnLoadMore = document.getElementById('btnLoadMore');

        function renderProducts(){
            let res = PRODUCTS_MASTER.filter(p=>{
                if(state.searchQuery && !p.name.toLowerCase().includes(state.searchQuery.toLowerCase())){
                    return false;
                }
                if(state.filters.prendas.size){
                    if(!p.prendas.some(x=> state.filters.prendas.has(x))) return false;
                }
                if(state.filters.estilo.size){
                    if(!p.estilo.some(x=> state.filters.estilo.has(x))) return false;
                }
                if(state.filters.temporada.size){
                    if(!p.temporada.some(x=> state.filters.temporada.has(x))) return false;
                }
                if(state.filters.colores.size){
                    if(!state.filters.colores.has(p.color)) return false;
                }
                return true;
            });

            res.sort((a,b)=>{
                switch(state.sort){
                    case 'name-asc': return a.name.localeCompare(b.name);
                    case 'name-desc': return b.name.localeCompare(a.name);
                    case 'price-asc': return a.price - b.price;
                    case 'price-desc': return b.price - a.price;
                    case 'new-desc': return new Date(b.date) - new Date(a.date);
                    case 'new-asc': return new Date(a.date) - new Date(b.date);
                    default: return 0;
                }
            });

            const visible = res.slice(0, state.visibleCount);

            productsGrid.innerHTML = visible.map(p => `
                <article class="card" data-id="${p.id}">
                    <div class="thumb" role="img" aria-label="${escapeHtml(p.name)}">
                        <img src="${p.img}" alt="${escapeHtml(p.name)}"/>
                    </div>
                    <div class="name">${escapeHtml(p.name)}</div>
                </article>
            `).join('');

            if(res.length > state.visibleCount) {
                btnLoadMore.style.display = 'block';
            } else {
                btnLoadMore.style.display = 'none';
            }
        }

        function escapeHtml(text){
            return text.replace(/[&<>"']/g, (m)=> ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[m]);
        }

        const btnFilters = document.getElementById('btnFilters');
        const filtersPanel = document.getElementById('filtersPanel');
        const closeFilters = document.getElementById('closeFilters');
        const applyFilters = document.getElementById('applyFilters');
        const clearFilters = document.getElementById('clearFilters');

        (function renderColorSwatches(){
            const container = document.getElementById('colorSwatches');
            container.innerHTML = COLOR_PALETTE.map(c=>{
                return `<span class="color-swatch" title="${c.name}" data-color="${c.name}" style="background:${c.hex}"></span>`;
            }).join('');
        })();

        btnFilters.addEventListener('click', ()=>{
            const open = filtersPanel.classList.toggle('open');
            filtersPanel.setAttribute('aria-hidden', !open);
            btnFilters.setAttribute('aria-expanded', open);
        });
        closeFilters.addEventListener('click', ()=> {
            filtersPanel.classList.remove('open');
            filtersPanel.setAttribute('aria-hidden', 'true');
            btnFilters.setAttribute('aria-expanded', 'false');
        });

        document.addEventListener('click', (e)=>{
            if(!filtersPanel.classList.contains('open')) return;
            if(e.target.closest('.filters-panel') || e.target.closest('#btnFilters')) return;
            filtersPanel.classList.remove('open');
            filtersPanel.setAttribute('aria-hidden', 'true');
            btnFilters.setAttribute('aria-expanded', 'false');
        });

        let tempFilters = {
            prendas: new Set(),
            estilo: new Set(),
            temporada: new Set(),
            colores: new Set()
        };

        document.querySelectorAll('input[type=checkbox][data-filter-group]').forEach(chk=>{
            chk.addEventListener('change', (e)=>{
                const group = chk.dataset.filterGroup;
                const val = chk.value;
                if(chk.checked) tempFilters[group].add(val);
                else tempFilters[group].delete(val);
            });
            const group = chk.dataset.filterGroup;
            if(state.filters[group] && state.filters[group].has(chk.value)){
                chk.checked = true;
                tempFilters[group].add(chk.value);
            }
        });

        document.getElementById('colorSwatches').addEventListener('click', (e)=>{
            const el = e.target.closest('.color-swatch');
            if(!el) return;
            const colorName = el.dataset.color;
            if(el.classList.contains('selected')){
                el.classList.remove('selected');
                tempFilters.colores.delete(colorName);
            } else {
                el.classList.add('selected');
                tempFilters.colores.add(colorName);
            }
        });

        clearFilters.addEventListener('click', ()=>{

            document.querySelectorAll('input[type=checkbox][data-filter-group]').forEach(chk=>{
                chk.checked = false;
            });
            document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('selected'));
            tempFilters = { prendas: new Set(), estilo: new Set(), temporada: new Set(), colores: new Set() };
            state.filters = { prendas: new Set(), estilo: new Set(), temporada: new Set(), colores: new Set() };
            state.visibleCount = 12;
            renderProducts();
        });

        applyFilters.addEventListener('click', ()=>{
            state.filters.prendas = new Set(tempFilters.prendas);
            state.filters.estilo = new Set(tempFilters.estilo);
            state.filters.temporada = new Set(tempFilters.temporada);
            state.filters.colores = new Set(tempFilters.colores);
            state.visibleCount = 12;
            renderProducts();
            filtersPanel.classList.remove('open');
            filtersPanel.setAttribute('aria-hidden', 'true');
            btnFilters.setAttribute('aria-expanded', 'false');
        });

        const globalSearch = document.getElementById('globalSearch');
        const selectSort = document.getElementById('selectSort');

        globalSearch.addEventListener('input', (e)=>{
            state.searchQuery = e.target.value.trim();
            state.visibleCount = 12;
            renderProducts();
        });

        selectSort.addEventListener('change', (e)=>{
            state.sort = e.target.value;
            renderProducts();
        });

        btnLoadMore.addEventListener('click', ()=>{
            state.visibleCount += 8;
            renderProducts();
        });

        (function initFromDOM(){
            document.querySelectorAll('input[type=checkbox][data-filter-group]').forEach(chk=>{
                if(chk.checked){
                    tempFilters[chk.dataset.filterGroup].add(chk.value);
                }
            });
            ['prendas','estilo','temporada'].forEach(group=>{
                document.querySelectorAll(`input[data-filter-group="${group}"]`).forEach(chk=>{
                    if(state.filters[group] && state.filters[group].has(chk.value)){
                        chk.checked = true;
                        tempFilters[group].add(chk.value);
                    }
                });
            });
            document.querySelectorAll('.color-swatch').forEach(s=>{
                const name = s.dataset.color;
                if(state.filters.colores && state.filters.colores.has(name)){
                    s.classList.add('selected');
                    tempFilters.colores.add(name);
                }
            });
        })();

        renderProducts();

    </script>
</body>
</html>
