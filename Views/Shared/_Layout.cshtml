@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OPA</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

    <style>
      /* Header degradado EB006B → negro → EB006B */
      .opa-gradient-header{ background: linear-gradient(90deg, #EB006B 0%, #0b0b0b 45%, #0b0b0b 55%, #EB006B 100%); }
      .opa-navbar{ padding-top: 1rem; padding-bottom: 1rem; font-size: 1.05em; }
      .opa-logo-box{ background:#ffffff; border-radius:12px; padding:6px 8px; display:flex; align-items:center; }
      .opa-logo-box img{ height:30px; width:auto; display:block; }
      .opa-icon{ width:28px; height:28px; object-fit:contain; display:block; }
      .opa-icon-white{ filter: invert(1) brightness(100%); }
      .opa-search-active{ filter:none; }
      .opa-search-form{ max-width:520px; width:100%; }
      .opa-search-input{ width:0; opacity:0; overflow:hidden; transition: width .22s ease, opacity .22s ease; }
      .opa-search-input.show{ width: clamp(220px, 40vw, 540px); opacity:1; }
      .navbar-toggler{ border: none; transform: scale(1.05); }
      .navbar-toggler .navbar-toggler-icon{ filter: invert(1); width: 1.5em; height: 1.5em; }
      .offcanvas{ background-color:#ffffff; }
      .offcanvas-header{ border-bottom:0; }
      .offcanvas-body a{ text-decoration:none; color:#000; font-weight:500; padding:.4rem 0; }
      .offcanvas-body a:hover{ opacity:.7; }
      .offcanvas-body a img{ width:24px; height:24px; object-fit:contain; }
      .menu-section, .menu-footer{ display:flex; flex-direction:column; }
      .menu-section a{ margin-bottom:1.1rem; }
      .menu-footer{ margin-top:auto; }
      main{margin-top:5%;}
      
      @@media (max-width: 320px) {
        .opa-navbar{ padding-top: 0.5rem; padding-bottom: 0.5rem; font-size: 0.9em; }
        .opa-logo-box{ padding: 4px 6px; }
        .opa-logo-box img{ height: 24px; }
        .opa-icon{ width: 1.5em; height: 1.5em; min-width: 22px; min-height: 22px; }
        .navbar-toggler{ transform: scale(1); padding: 0.25rem 0.5rem; }
        .navbar-toggler .navbar-toggler-icon{ width: 1.5em; height: 1.5em; }
        .opa-search-form{ max-width: 100%; }
        .opa-search-input.show{ width: clamp(150px, 60vw, 280px); }
        .offcanvas-body a img{ width: 20px; height: 20px; }
        main{ margin-top: 8%; }
        .container-fluid{ padding-left: 0.5rem; padding-right: 0.5rem; }
      }
      footer {
        display: flex;
        width: 100%;
        margin-top: 0.5%;
        padding: 2rem 1rem;
        padding-bottom: 3rem;
        background: #111;
        color: #e9e7da;
        box-sizing: border-box;
      }
      
      footer img {
        margin-left: 1%;
        margin-right: 5%;
        margin-top: 5%;
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
      }
      
      footer section {
        display: flex;
        gap: 8%;
        margin-left: auto;
        margin-top: 3%;
      }
      footer li{
        width:120%;
        margin-right: 3%;
      }
      footer a {
        padding: 3%;
        border: 2px solid #d70162;
        border-radius: 10px;
        text-decoration: none;
        color: #e9e7da;
        display: block;
        margin-bottom: 5%;
        font-size: 0.9rem;
      }
      
      footer .links {
        margin-left: 10%;
        margin-top: 5%;
      }
      
      footer a:hover {
        border: none;
      }
      
      footer ul {
        list-style-type: none;
        padding-left: 0%;
        margin: 0;
      }
      
      footer h4 {
        margin-bottom: 0.75rem;
        font-size: 1rem;
      }
      
      footer p {
        margin: 0.5rem 0;
        font-size: 0.85rem;
      }
      
      footer section div {
        min-width: 150px;
      }
      
      @@media (max-width: 320px) {
        footer {
          flex-direction: column;
          padding: 1.5rem 0.75rem;
          padding-bottom: 2rem;
          margin-top: 1rem;
          width: 100%;
          max-width: 100%;
          box-sizing: border-box;
        }
        
        footer img {
          width: 60px;
          height: 60px;
          object-fit: cover;
          border-radius: 8px;
          margin: 0 auto 1rem auto;
          display: block;
        }
        
        footer .links {
          margin-left: 0;
          margin-top: 0;
          margin-bottom: 1.5rem;
          width: 100%;
        }
        
        footer .links ul {
          display: flex;
          flex-wrap: wrap;
          gap: 0.5rem;
          justify-content: center;
        }
        
        footer .links li {
          flex: 0 0 auto;
        }
        
        footer .links a {
          padding: 0.5rem 0.75rem;
          margin-bottom: 0;
          font-size: 0.75rem;
          border-width: 1px;
        }
        
        footer section {
          flex-direction: column;
          gap: 1.5rem;
          margin-left: 0;
          margin-top: 0;
          width: 100%;
        }
        
        footer section div {
          min-width: 100%;
          width: 100%;
        }
        
        footer section h4 {
          font-size: 0.9rem;
          margin-bottom: 0.5rem;
        }
        
        footer section ul {
          display: flex;
          flex-wrap: wrap;
          gap: 0.5rem;
        }
        
        footer section ul li {
          flex: 0 0 auto;
        }
        
        footer section a {
          padding: 0.4rem 0.6rem;
          margin-bottom: 0;
          font-size: 0.75rem;
          border-width: 1px;
        }
        
        footer section p {
          font-size: 0.75rem;
          line-height: 1.4;
          margin: 0.4rem 0;
        }
        
        footer section p a {
          display: inline;
          padding: 0;
          border: none;
          text-decoration: underline;
        }
      }
    </style>
</head>

<body>
<header>
   
  <nav class="navbar opa-gradient-header opa-navbar fixed-top">
    <div class="container-fluid align-items-center">

      <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index","Home")">
        <span class="opa-logo-box">
          <img src="/img/logoOPA-03.png" alt="OPA"/>
        </span>
      </a>

      <div class="d-flex align-items-center gap-2 ms-auto">
        <form id="opaSearchForm" class="opa-search-form me-2" role="search" onsubmit="return false;">
          <div class="input-group opa-search-input" id="opaSearchInput">
            <input id="opaSearchText" type="text" class="form-control rounded-4" placeholder="Buscar" aria-label="Buscar">
          </div>
        </form>

        <button id="opaSearchBtn" type="button" class="btn btn-link p-0 m-0" aria-label="Buscar">
          <img id="opaSearchIcon" class="opa-icon" src="/img/whiteSearch.png" alt="Buscar">
        </button>

      <a href="/Armario/Armario" class="btn btn-link p-0 m-0" aria-label="Armario">
              <img src="~/img/armario.png" class="opa-icon" alt="Armario" />
            </a>
            
        <a class="btn btn-link p-0 m-0" href="@Url.Action("verCarrito","Compra")" aria-label="Carrito">
          <img class="opa-icon" src="/img/whiteTienda.png" alt="Carrito">
        </a>

        <button class="navbar-toggler ms-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
      </div>

      <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
        <div class="offcanvas-header">
          <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body d-flex flex-column justify-content-between">

          <div class="menu-section">
            <a href="/Home/Index" class="d-flex align-items-center mb-3 text-decoration-none">
              <img src="~/img/home.png" class="me-2" width="24" alt="Home" />
              <span>HOME</span>
            </a>

            <a href="/Armario/Armario" class="d-flex align-items-center mb-3 text-decoration-none">
              <img src="~/img/armario.png" class="me-2" width="24" alt="Armario" />
              <span>MI ARMARIO</span>
            </a>

            <a href="#" class="d-flex align-items-center mb-3 text-decoration-none">
              <img src="~/img/formulario.png" class="me-2" width="24" alt="Estilo" />
              <span>ENCONTRÁ TU ESTILO</span>
            </a>
        
            <a href="#" class="d-flex align-items-center mb-3 text-decoration-none">
              <img src="~/img/outfit.png" class="me-2" width="24" alt="Outfits" />
              <span>OUTFITS</span>
            </a>


            <a href="#" class="d-flex align-items-center mb-3 text-decoration-none">
              <img src="~/img/billetera.png" class="me-2" width="24" alt="Mi billetera" />
              <span>MI BILLETERA</span>
            </a>
  <a href="/Home/LandingPage" class="d-flex align-items-center mb-3 text-decoration-none">
              <img src="~/img/pregunta.png" class="me-2" width="24" alt="Estilo" />
              <span>¿QUIENES SOMOS?</span>
            </a>
            <a href="#" class="d-flex align-items-center mb-3 text-decoration-none">
              <img src="~/img/ayuda.png" class="me-2" width="24" alt="Ayuda" />
              <span>NECESITO AYUDA</span>
            </a>
          </div>
          <div class="menu-footer">
            @{
                var modoUsuario = Context.Session.GetString("ModoUsuario") ?? "Comprador";
                bool esVendedor = string.Equals(modoUsuario, "Vendedor", StringComparison.OrdinalIgnoreCase);
            }
            @if (esVendedor)
            {
                <a href="@Url.Action("CambiarAComprador","Comprador")" class="d-flex align-items-center mb-3 text-decoration-none">
                  <span class="me-2">&#8646;</span>
                  <span>CAMBIAR A COMPRADOR</span>
                </a>
            }
            else
            {
                <a href="@Url.Action("CambiarAVendedor","Comprador")" class="d-flex align-items-center mb-3 text-decoration-none">
                  <span class="me-2">&#8646;</span>
                  <span>CAMBIAR A VENDEDOR</span>
                </a>
            }

            <a href="/Comprador/VistaUsuario" class="d-flex align-items-center text-decoration-none">
              <img src="~/img/perfil.png" class="me-2" width="24" alt="Perfil" />
              <span>PERFIL</span>
            </a>
          </div>

        </div>
      </div>

    </div>
  </nav>

</header>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

<main role="main">
    @RenderBody()
</main>


    <footer>
      <img src="/img/logoOPA-03.png" alt="" />
     
        <div class="links">
      <ul>
        <li><a href="/Home/Index">Catálogo</a></li>
        <li><a href="/Home/LandingPage">Nosotros</a></li>
        <li><a href="/Comprador/IniciarSesion">Iniciar sesión</a></li>
        <li><a href="/Comprador/Registrarse">Registrarse</a></li>
      </ul>
    </div>
    <section>
    <div>
      <h4>Seguinos</h4>
       <ul>
      <li><a href="#">Facebook</a></li>
       <li><a href="#">Instagram</a></li>
       <li><a href="#">Twitter</a></li>
       <li><a href="#">YouTube</a></li>
      </ul>
    </div>
    <div>
      <h4>Información</h4>
      <p>© 2025 OPA. Todos los derechos reservados.</p>
      <p><a href="#">Política de privacidad</a></p>
      <p><a href="#">Términos y condiciones</a></p>
      <p>Email: contacto@Opa.com</p>
    </div>
</section>
    </footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
  (function(){
    const btn = document.getElementById('opaSearchBtn');
    const icon = document.getElementById('opaSearchIcon');
    const inputWrap = document.getElementById('opaSearchInput');
    const text = document.getElementById('opaSearchText');
    let open = false;

    function toggle(){
      open = !open;
      inputWrap.classList.toggle('show', open);
      icon.src = open ? '/img/search.png' : '/img/whiteSearch.png';
      if(open){ setTimeout(()=>text.focus(), 10); }
    }

    btn?.addEventListener('click', toggle);

    function go(){
      const q = (text.value || '').trim();
      if(q.length>0){
        const url = '@Url.Action("Explorar","Home")' + '?q=' + encodeURIComponent(q);
        window.location.href = url;
      }
    }

    text?.addEventListener('keydown', function(e){ if(e.key === 'Enter'){ e.preventDefault(); go(); }});
    text?.addEventListener('blur', function(){ open=false; inputWrap.classList.remove('show'); icon.src='/img/whiteSearch.png'; });
    document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && open){ open=false; inputWrap.classList.remove('show'); icon.src='/img/whiteSearch.png'; text.blur(); }});
  })();
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
