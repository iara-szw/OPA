
@{
	ViewData["Title"] = "Mi Perfil";
}
<body>
<style>
	.perfil-card { border: 1px solid #aaa; border-radius: 10px; padding: 15px; margin: 10px auto; max-width: 300px; }
	.perfil-btn { border: 1px solid black; border-radius: 8px; width: 100%; margin-top: 10px; }
	.perfil-btn:hover { background-color: #f8f9fa; box-shadow: 0 1px 0 rgba(0,0,0,.1) inset; }
	#cerrar{
		width:3%;
		margin-bottom:1%;
	}
	#cerrar:hover{
		cursor:pointer;
	}
	.perfil-img { width: 150px; height: 150px; border-radius: 50%; border: 5px solid #d60077; display: inline-block; object-fit: cover; }
	@@media (min-width: 768px) { .perfil-card { max-width: 100%; } }
	.row.g-4.text-start{
		MARGIN-left:5%;
	}
	.col-12.col-md-6{
		width:50%;
				background-color:white;

	}

.informacion {
    display: flex;
    margin-left: 5%;
}
.button.btn.btn-light.perfil-btn{
	background-color:rgb(0, 0, 0) !important;
	color:white !important;
}
	.perfil-btn:hover {
    box-shadow: 1px 5px 10px rgb(209 2 96);
}
.perfil-btn {
    background-color: #000;
    color: white;
    border: solid 1px black;
}
.card.perfil-card.h-100 {
    border: 2px solid black;
}
#videotutorial{
	top: 17%;
    position: absolute;
    left: 25%;
	
}
iframe{
	width:110%;
	border:2px solid black;
	border-radius:10px;
}
</style>

<div class="container my-5 text-center">
	<div class="row justify-content-center align-items-center mb-4 g-3">
		
		<div class="col-12 col-md-auto">
			<h1 class="display-5 fw-bold m-0">¡HOLA @((ViewBag.usu?.Nombre as string ?? "").ToUpper())!</h1>
		</div>
		
	</div>
	<div class="informacion" style="display:flex">
	<div class="col-auto">
			@if (!string.IsNullOrEmpty(ViewBag.usu?.FotoDePerfil))
			{
				<img src="@ViewBag.usu.FotoDePerfil" alt="Usuario" class="perfil-img" />
			}
			else
			{
				<div class="perfil-img" style="background:#f8f9fa; display:flex; align-items:center; justify-content:center; color:#999; font-weight:600;">
					<span>U</span>
				</div>
			}
		</div>
	<div class="row g-4 text-start" style="width:70%;">
		<div class="col-12 col-md-6">
			<div class="card perfil-card h-100">
				<div class="card-body">
					<h3 class="h5 text-center mb-3">INFORMACIÓN PERSONAL</h3>
					<div class="mb-2">
						<div class="fw-semibold small text-muted">NOMBRE</div>
						<div>@(ViewBag.usu?.Nombre) @(ViewBag.usu?.Apellido)</div>
					</div>
					<div class="mb-2">
						<div class="fw-semibold small text-muted">MAIL</div>
						<div>@(ViewBag.usu?.Mail)</div>
					</div>
					<div class="mb-2">
						<div class="fw-semibold small text-muted">TELÉFONO</div>
						<div>@(ViewBag.usu?.Telefono)</div>
					</div>
					<div class="mb-3">
						<div class="fw-semibold small text-muted">CONTRASEÑA</div>
						<div>********...</div>
					</div>
					<form action='@Url.Action("editarUsuario")'>
						<button type="submit" class="btn btn-light perfil-btn">EDITAR DATOS</button>
					</form>
					<form action='@Url.Action("cerrarSesion","Comprador")' class="mb-2">
				<button type="submit" class="btn btn-light perfil-btn">Cerrar sesión</button>
			</form>
				</div>
			</div>
		</div>
	
		<div class="col-12 col-md-6">
			<div class="card perfil-card h-100">
				<div class="card-body">
					<h3 class="h5 text-center mb-3">MEDIDAS</h3>
					<div class="mb-2" style="display:flex;">
						<div class="fw-semibold small text-muted">TALLE TORSO</div>
						<p>@(ViewBag.medidas.MedidaTorso == 0 ? "vacio" : ViewBag.medidas.MedidaTorso) cm</p>
					</div>
					<div class="mb-2" style="display:flex;">
						<div class="fw-semibold small text-muted">TALLE CINTURA</div>
						<p>@(ViewBag.medidas.MedidaCintura == 0 ? "vacio" : ViewBag.medidas.MedidaCintura) cm</p>
					</div>
					<div class="mb-2" style="display:flex;">
						<div class="fw-semibold small text-muted">TALLE PIERNAS</div>
						<p>@(ViewBag.medidas.MedidaPierna == 0 ? "vacio" : ViewBag.medidas.MedidaPierna) cm</p>
					</div>
					<div class="mb-2" style="display:flex;">
						<div class="fw-semibold small text-muted">TALLE HOMBROS</div>
						<p>@(ViewBag.medidas.MedidaHombros == 0 ? "vacio" : ViewBag.medidas.MedidaHombros) cm</p>
					</div>
					<div class="mb-2" style="display:flex;">
						<div class="fw-semibold small text-muted">TALLE BRAZOS</div>
						<p>@(ViewBag.medidas.MedidaBrazos == 0 ? "vacio" : ViewBag.medidas.MedidaBrazos) cm</p>
					</div>
					<div class="mb-2" style="display:flex;">
						<div class="fw-semibold small text-muted">TALLE CADERA</div>
						<p>@(ViewBag.medidas.MedidaCadera == 0 ? "vacio" : ViewBag.medidas.MedidaCadera) cm</p>
					</div>
					<form action="/Comprador/editarMedidas" class="mb-2">
						<button type="submit" class="btn btn-light perfil-btn">EDITAR DATOS</button>
					</form> 
					<button type="button" class="btn btn-light perfil-btn" onclick="verTutorial()">VER TUTORIAL</button>
				</div>
			</div>
		</div>
	</div>
</div>

	</div>
</div>
<div id="videotutorial" style="display:none;position:absolute">
<img id="cerrar" src="/img/cruz.png" onclick="cerrarTutorial()">
<iframe width="600" height="500" src="https://www.youtube.com/embed/3NoIx9cbZyE?si=HgeN5gLDnI4rqdVk" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
</div>
</body>
<script>
function verTutorial(){
	var video = document.getElementById("videotutorial");
	video.style.display="block";
}

function cerrarTutorial(){
		var video = document.getElementById("videotutorial");

	video.style.display="none";

}

</script>