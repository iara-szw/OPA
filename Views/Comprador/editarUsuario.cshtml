@{
	ViewData["Title"] = "Editar Usuario";
}

<style>
	.perfil-card { border: 1px solid #aaa; border-radius: 14px; }
	.perfil-btn { border-radius: 10px; }
</style>

<main class="container my-5">
	<h2 class="text-center mb-4">Editar mis datos</h2>

	<div id="alerta" class="alert alert-danger d-none"></div>

	<div class="card shadow-sm p-4 mx-auto perfil-card" style="max-width:640px;">
		<form id="formEditar" novalidate>
			<h5 class="mb-3">Información personal</h5>
			<div class="mb-3">
				<label for="nombre" class="form-label">Nombre completo</label>
				<input id="nombre" class="form-control form-control-lg" required>
				<div class="invalid-feedback">Ingresá tu nombre.</div>
			</div>
			<div class="mb-3">
				<label for="mail" class="form-label">Email</label>
				<input id="mail" type="email" class="form-control form-control-lg" required>
				<div class="invalid-feedback">Ingresá un email válido.</div>
			</div>
			<div class="mb-3">
				<label for="telefono" class="form-label">Teléfono</label>
				<input id="telefono" type="tel" class="form-control form-control-lg" required>
				<div class="invalid-feedback">Ingresá tu teléfono.</div>
			</div>
			<div class="mb-4">
				<label for="contrasenia" class="form-label">Contraseña</label>
				<input id="contrasenia" type="password" class="form-control form-control-lg" minlength="6">
				<div class="form-text">Dejala vacía para no cambiarla.</div>
			</div>

			<h5 class="mb-3">Medidas</h5>
			<div class="row">
				<div class="col-md-6 mb-3">
					<label for="torso" class="form-label">Torso (cm)</label>
					<input id="torso" type="number" min="0" step="0.1" class="form-control form-control-lg">
					<div class="invalid-feedback">Valor inválido.</div>
				</div>
				<div class="col-md-6 mb-3">
					<label for="piernas" class="form-label">Piernas (cm)</label>
					<input id="piernas" type="number" min="0" step="0.1" class="form-control form-control-lg">
					<div class="invalid-feedback">Valor inválido.</div>
				</div>
				<div class="col-md-6 mb-3">
					<label for="cintura" class="form-label">Cintura (cm)</label>
					<input id="cintura" type="number" min="0" step="0.1" class="form-control form-control-lg">
					<div class="invalid-feedback">Valor inválido.</div>
				</div>
				<div class="col-md-6 mb-4">
					<label for="calzado" class="form-label">Calzado</label>
					<input id="calzado" type="number" min="0" step="1" class="form-control form-control-lg">
					<div class="invalid-feedback">Valor inválido.</div>
				</div>
			</div>

			<div class="d-flex justify-content-between pt-2">
				<button type="submit" class="btn btn-dark btn-lg px-4 perfil-btn" id="btnGuardar">Guardar cambios</button>
				<a href="/comprador/vistaUsuario" class="btn btn-outline-dark btn-lg px-4 perfil-btn">Cancelar</a>
			</div>
		</form>
	</div>
</main>

@section Scripts {
<script>
    // Cargar datos reales del usuario
    async function cargarDatos() {
        const res = await fetch('/Comprador/PerfilActual', { credentials: 'same-origin' });
        if (!res.ok) return;
        const json = await res.json();
        if (!json?.ok) return;
        const d = json.data || {};
        // Heurística para nombre completo
        document.getElementById('nombre').value = d.nombre || '';
        document.getElementById('mail').value = d.mail || '';
        document.getElementById('telefono').value = d.telefono || '';
        if (typeof d.medidaTorso === 'number' && d.medidaTorso > 0) {
            document.getElementById('torso').value = d.medidaTorso;
        }
    }

    // Subir datos al backend
    async function subirDatos(payload) {
        const res = await fetch('/Comprador/ActualizarUsuario', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify(payload)
        });
        if (!res.ok) {
            try { const err = await res.json(); throw new Error(err?.error || 'error'); }
            catch { return false; }
        }
        const json = await res.json();
        if (!json?.ok) { throw new Error(json?.error || 'error'); }
        return true;
    }

	(function () {
		const form = document.getElementById('formEditar');
		const alerta = document.getElementById('alerta');
		const btnGuardar = document.getElementById('btnGuardar');
		const nombre = document.getElementById('nombre');
		const mail = document.getElementById('mail');
		const telefono = document.getElementById('telefono');
		const contrasenia = document.getElementById('contrasenia');
		const torso = document.getElementById('torso');
		const piernas = document.getElementById('piernas');
		const cintura = document.getElementById('cintura');
		const calzado = document.getElementById('calzado');

		function mostrarError(msg){ alerta.textContent = msg || 'Ocurrió un error.'; alerta.classList.remove('d-none'); }
		function ocultarError(){ alerta.classList.add('d-none'); alerta.textContent=''; }

		function validar() {
			if (!form.checkValidity()) { form.classList.add('was-validated'); return false; }
			form.classList.add('was-validated'); return true;
		}

		form.addEventListener('submit', async (e) => {
			e.preventDefault(); ocultarError();
			if (!validar()) return;

			const payload = {
				nombre: nombre.value.trim(),
				mail: mail.value.trim(),
				telefono: telefono.value.trim(),
				contrasenia: contrasenia.value, // vacío = no cambiar
				medidas: {
					torso: parseFloat(torso.value) || null,
					piernas: parseFloat(piernas.value) || null,
					cintura: parseFloat(cintura.value) || null,
					calzado: parseInt(calzado.value) || null
				}
			};

			btnGuardar.disabled = true;
			try {
				const ok = await subirDatos(payload);
				if (ok) window.location.href = '/comprador/vistaUsuario';
				else mostrarError('No se pudieron guardar los cambios.');
			} catch (err) {
				mostrarError(err?.message || 'No se pudieron guardar los cambios.');
			} finally {
				btnGuardar.disabled = false;
			}
		});

		cargarDatos();
	})();
</script>
}


