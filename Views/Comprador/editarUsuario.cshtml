@using Newtonsoft.Json

@{
	ViewData["Title"] = "Editar Usuario";
}

<style>
	.perfil-card { border: 1px solid #aaa; border-radius: 14px; }
	.perfil-btn { border-radius: 10px; }
</style>

<main class="container my-5">
	<h2 class="text-center mb-4">Editar mis datos</h2>

	<div id="alerta" class="alert alert-danger d-none"></div>
	<div id="usu" style="display:none" value="@ViewBag.Usu"> </div>
	<div class="card shadow-sm p-4 mx-auto perfil-card" style="max-width:640px;">
		<form id="formEditar" novalidate>
			<h5 class="mb-3">Información personal</h5>
			<div class="mb-3">
				<label for="nombre" class="form-label">Nombre</label>
				<input id="nombre" name="nombre" class="form-control form-control-lg" placeholder="@ViewBag.Usu.Nombre" >
				<div class="form-text">Ingresá tu nombre.</div>
			</div>
			<div class="mb-3">
				<label for="apellido" class="form-label">Apellido</label>
				<input id="apellido" class="form-control form-control-lg" placeholder="@ViewBag.Usu.Apellido" >
				<div class="form-text">Ingresá tu Apellido.</div>
			</div>
			<div class="mb-3">
				<label for="mail" class="form-label">Email</label>
				<input id="mail" type="email" class="form-control form-control-lg" placeholder="@ViewBag.Usu.Mail" >
				<div class="form-text">Ingresá un email válido.</div>
			</div>
			<div class="mb-3">
				<label for="telefono" class="form-label">Teléfono</label>
				<input id="telefono" type="tel" class="form-control form-control-lg" placeholder="@ViewBag.Usu.Telefono" >
				<div class="form-text">Ingresá tu teléfono.</div>
			</div>
			<div class="mb-4">
				<label for="contrasenia" class="form-label">Contraseña</label>
				<input id="contrasenia" type="password" class="form-control form-control-lg" minlength="6">
				<div class="form-text">Dejala vacía para no cambiarla.</div>
			</div>

			<!-- <h5 class="mb-3">Medidas</h5>
			<div class="row">
				<div class="col-md-6 mb-3">
