					<div class="invalid-feedback">Valor inválido.</div>
				</div>
			</div> -->

			<div class="d-flex justify-content-between pt-2">
				<button type="submit" class="btn btn-dark btn-lg px-4 perfil-btn" id="btnGuardar">Guardar cambios</button>
				<a href="/comprador/vistaUsuario" class="btn btn-outline-dark btn-lg px-4 perfil-btn">Cancelar</a>
			</div>
		</form>
	</div>
</main>

<script>
async function subirDatos(payload) {
    const res = await fetch('/Comprador/editarPerfil', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(payload)
    });

    const json = await res.json();
    return json;
}

(function () {
    var usu = @Html.Raw(JsonConvert.SerializeObject(ViewBag.Usu));
    const form = document.getElementById('formEditar');
    const alerta = document.getElementById('alerta');
    const btnGuardar = document.getElementById('btnGuardar');

    const nombre = document.getElementById('nombre');
    const apellido = document.getElementById('apellido');
    const mail = document.getElementById('mail');
    const telefono = document.getElementById('telefono');
    const contrasenia = document.getElementById('contrasenia');
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        alerta.classList.add("d-none");
 if(nombre.value==""){
        nombre.value=usu.Nombre;
    }
    if(apellido.value==""){
        apellido.value=usu.Apellido;

    }
    if(mail.value==""){
        mail.value=usu.Mail;
    }
    if(telefono.value==""){
        telefono.value=usu.Telefono;
    }
	 if(contrasenia.value==""){
		contrasenia.value=usu.Contraseña;
	 }
        const payload = {
            nombre: nombre.value,
            apellido: apellido.value,
            mail: mail.value,
            telefono: telefono.value,
            contrasenia: contrasenia.value
        };
		console.log('Payload:', payload); 
        btnGuardar.disabled = true;

        try {
            const resp = await subirDatos(payload);

            if (resp.ok) {
                window.location.href = '/comprador/vistaUsuario';
                return;
            }

            alerta.textContent = resp.error || "No se pudieron guardar los cambios.";
            alerta.classList.remove("d-none");

        } catch (err) {
            alerta.textContent = "Error inesperado: " + err.message;
            alerta.classList.remove("d-none");
        }

        btnGuardar.disabled = false;
    });
})();
</script>
