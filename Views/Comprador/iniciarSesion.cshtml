<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión</title>
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/iniciarSesion.css" asp-append-version="true" />

  </head>
  <body>
    <div class="container">
        <div class="row g-4" id="inicios">
            <!-- Panel izquierdo: Branding -->
            <div class="col-lg-5">
                <div class="brand-card">
                    <div class="logo-section">
                        <div class="mb-4">
                            <img src="~/img/logoOPA-03.png" alt="OPA" style="height: 50px; width: auto;" />
                        </div>
                        <h2>Inicia sesion</h2>
                        <p>Accede a tu armario personal, guarda prendas y comparti tus outfits.</p>
                    </div>
                    
                    <div class="support-badge">
                        💬 Soporte 24/7
                    </div>
                </div>
            </div>

            <!-- Panel derecho: Formulario -->
            <div class="col-lg-7">
                <div class="form-card">
                        <form action='@Url.Action("comprobarDatos")' id="formUsuario">
                        <div class="mb-4">
          <label for="Nombre" class="form-label" required-field>Nombre de usuario</label>
            <input type="text" placeholder="Nombre de usuario" name="nombreUsuario" id="nombreUsuario" class="form-control" required />

                        </div>
                        <div class="mb-4">
           <label for="password" class="form-label">Contraseña</label>
            <input type="password" placeholder="Contraseña" name="password" id="password" class="form-control" required />
                        </div>
  
                        <div class="d-flex gap-3 justify-content-end flex-wrap">
                         @if(ViewBag.estado=="error"){
                          <h2>El usuario o contraseña son incorrectos.</h2>
                             }
                                                         <a href='@Url.Action("registrarse")' class="btn btn-secondary-custom">Registrarse</a>
                            <button type="submit" class="btn btn-primary-custom">Iniciar sesion</button>
                        </div>
                    </form>
                </div>
            </div>
    </div>
</div>


  </body>