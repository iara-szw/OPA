                     <div style="font-weight:700; margin-bottom:6px;">Estilos</div>

              @foreach (var estilo in (IEnumerable<Estilo>)(ViewBag.estilos ?? Enumerable.Empty<Estilo>()))
              {
                <span class="chip">@estilo.Nombre</span>
