    .preferencias .card{
width:100%;
    }
        .preferencias .card:hover{
          transform:translateY(0px) scale(1); box-shadow:0 00px 0px rgba(0,0,0,0);
        }

    .card:hover { transform:translateY(-2px) scale(1.01); box-shadow:0 10px 20px rgba(0,0,0,.06); }
