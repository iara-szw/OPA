@{
    var tienda = ViewBag.tienda;
    var productos = ViewBag.productos as IEnumerable<dynamic> ?? new List<dynamic>();
    bool permisos = ViewBag.permisos ?? false;
    ViewData["Title"] = tienda?.Nombre ?? "Tienda";
}

<div class="container my-4">
    <div class="text-center mb-4">
        <h1 class="fw-bold text-uppercase">¡HOLA @tienda.Nombre!</h1>
    </div>

    <div class="row g-4 align-items-stretch">
        <!-- Panel izquierdo: Información de tienda -->
        <div class="col-12 col-lg-4">
            <div class="card h-100 shadow-sm border-2">
                <div class="card-body">
                    <div class="mb-2 small text-muted">NOMBRE</div>
                    <div class="fw-semibold mb-3">@tienda.Nombre</div>

                    <div class="mb-2 small text-muted">MAIL</div>
                    <div class="fw-semibold mb-3">@tienda.Mail</div>

                    <div class="mb-2 small text-muted">TELÉFONO</div>
                    <div class="fw-semibold mb-3">@tienda.Telefono</div>

                    <div class="mb-2 small text-muted">UBICACIÓN</div>
                    <div class="fw-semibold mb-3">@tienda.Ubicacion</div>

                    @if (permisos)
                    {
                        <a class="btn btn-outline-dark w-100 mt-2" href="@Url.Action("editarTienda","Tienda")">EDITAR DATOS</a>
                    }
                </div>
            </div>
        </div>

        <!-- Centro: Avatar y CTA publicar -->
        <div class="col-12 col-lg-4 d-flex flex-column align-items-center gap-3">
            <div class="rounded-circle border border-4 border-dark overflow-hidden d-flex align-items-center justify-content-center" style="width: 180px; height: 180px;">
                @if (!string.IsNullOrEmpty(tienda.FotoDePerfil))
                {
                    <img src="@tienda.FotoDePerfil" alt="Perfil tienda" style="width:100%; height:100%; object-fit:cover;" />
                }
                else
                {
                    <span style="font-size:64px;">👤</span>
                }
            </div>

            @if (permisos)
            {
                <div class="text-center">
                    <p class="mb-2">¡Publicá tus nuevos productos!</p>
                    <a class="btn btn-light perfil-btn" href='@Url.Action("subidaProducto","Tienda")'>PUBLICAR</a>
                </div>
            }
        </div>

        <!-- Panel derecho: Opciones -->
        <div class="col-12 col-lg-4">
            <div class="card h-100 shadow-sm border-2">
                <div class="card-body d-grid gap-2">
                    @if (permisos)
                    {
                        <a class="btn btn-light perfil-btn" href="@Url.Action("verCarrito","Compra")">ADMINISTRAR PEDIDOS</a>
                        <a class="btn btn-light perfil-btn" href="@Url.Action("Index","Home")">VER ESTADÍSTICAS</a>
                    }
                    <a class="btn btn-light perfil-btn" href="@Url.Action("Index","Home")">AYUDA</a>
                    <a class="btn btn-light perfil-btn" href="@Url.Action("cerrarSesion","Comprador")">CERRAR SESIÓN</a>
                    @if (permisos)
                    {
                        <a class="btn btn-outline-danger w-100" href="@Url.Action("verTiendasAdministrador","Tienda")">ELIMINAR TIENDA</a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Carrusel de prendas -->
    <div class="mt-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h5 m-0">MIS PRENDAS ></h2>
        </div>
        <div class="d-flex gap-3 overflow-auto pb-2">
            @foreach (var p in productos)
            {
                <div class="border rounded-3 p-2 text-center" style="min-width: 170px;">
                    <div class="mb-2">
                        <img src="@p.foto" alt="@p.Modelo" style="width:150px; height:150px; object-fit:cover; border-radius:8px;" />
                    </div>
                    <div class="small fw-semibold">@p.Modelo</div>
                    <div class="text-muted small">$ @p.Precio</div>
                </div>
            }
            @if (!productos.Any())
            {
                <div class="text-muted">Todavía no hay prendas publicadas.</div>
            }
        </div>
    </div>
</div>
