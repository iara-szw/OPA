@{
    ViewData["Title"] = ViewBag.prenda?.Modelo ?? "Prenda";
    Layout = "~/Views/Shared/_Layout.cshtml";
                <link rel="stylesheet" href="~/css/vistaprenda.css" asp-append-version="true" />
}
   

<div class="prenda-page">
  <section class="prenda-wrapper">
      <div class="prenda-header">
        <h1>@ViewBag.prenda.Modelo</h1>
      </div>
      <section class="prenda-content">
        <div class="slider-card">
          <div class="slider-frame">
            <img src="@ViewBag.prenda.foto" alt="@ViewBag.prenda.Modelo" class="slider-image" />
            <div class="slider-controls">
              <button type="button" class="slider-btn">&#60;</button>
              <button type="button" class="slider-btn">&#62;</button>
            </div>
          </div>
        </div>
        <div class="info-card">
          <div class="price-row">
            <span class="price">$ @ViewBag.prenda.Precio</span>
          </div>
          <p class="desc">@ViewBag.prenda.descripcion</p>
          <div class="vendedor">VENDEDOR: @ViewBag.vendedor</div>
          <div class="section-title">ESTILOS</div>
          <div class="tags">
          @foreach(Estilo estilito in ViewBag.estilitos){
               <span class="tag">@estilito.Nombre</span>
          }
         
          </div>
          <div class="section-title">COLORES</div>
          <div class="color-options">
          @foreach(Prenda prenda in ViewBag.Similares){
            <a href="/Home/vistaPrenda?idPrenda=@prenda.IdPrenda"><span class="color-dot" style="background-color:#@PrendaBD.levantarColor(prenda.Color).codigoHexa"></span></a>
            }
          </div>
          <div class="section-title">TALLES</div>
          <div class="talles">
            <span class="talle">S</span>
            <span class="talle">M</span>
            <span class="talle">L</span>
          </div>
          <a class="btn-cart" href="/Tienda/EliminarPrenda?idPrenda=@ViewBag.prenda.IdPrenda">ELIMINAR PRENDA</a>
          </div>
        </div>
      </section>
  </section>
</div>

}