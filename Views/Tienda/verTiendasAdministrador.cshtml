@{
    var tiendas = ViewBag.tiendas;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Mis Tiendas</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background: white;
        }
        h2{
            text-align:center;
        }
        header {
            height: 70px;
            background: linear-gradient(90deg,#ff0174 0%,#000 55%,#ff0074 100%);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            color: white;
        }

        .container {
            padding-top: 60px;
            margin-left:0%;
            width:100% !important;
                max-width: none;
    
            display:inline-block;
        }

        .tienda-btn {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            border: none;
            background: #dcdcdc;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
            transition: .2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .tienda-btn:hover {
            background: #b5b5b5;
        }

        .nombre-tienda {
            position: relative;
            font-size: 13px;
            text-align: center;
            font-weight: 600;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        #formSeleccionarTienda{
            width: 50%;
    display: flex
;
    margin-top: 1%;
    justify-content: space-around;
    flex-wrap: wrap;
    justify-self:center;
}
#tiendaSeleccionar{
    margin:5%;
}
#tiendaSeleccionar:first-child{
}
    </style>
</head>

<body>

<div class="container">
<h2>Elegi la tienda a la que queres ingresar</h2>
 <form action='@Url.Action("seleccionarTienda")'  id="formSeleccionarTienda" method="post" style="text-align:center;">
    @foreach (Tienda t in tiendas)
    {
            <div class="tiendaSeleccionar">
            <input type="hidden" name="IdTienda" value="@t.IdTienda" />
 
            <button type="submit" class="tienda-btn">

            </button>
            <p class="nombre-tienda">@t.Nombre</p>
            </div>

    }
            </form>

</div>
<a href='@Url.Action("nuevaTienda")'>Agregar Tienda</a>
</body>
</html>
