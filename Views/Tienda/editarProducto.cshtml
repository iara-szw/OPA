@using OPA.Models
@using Newtonsoft.Json
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Editar producto";
    var prenda = ViewBag.prenda as Prenda;
    var estilosSeleccionados = ViewBag.estilosSeleccionados as List<int> ?? new List<int>();
    var temporadaSeleccionada = ViewBag.temporadaSeleccionada as int? ?? 0;
    var coloresSeleccionados = ViewBag.coloresSeleccionados as List<int> ?? new List<int>();
    var tallesSeleccionados = ViewBag.tallesSeleccionados as List<int> ?? new List<int>();
    var stockMap = ViewBag.stockMap as Dictionary<int, Dictionary<int, int>> ?? new Dictionary<int, Dictionary<int, int>>();
}

<head>
    <meta charset="utf-8" />
    <title>Editar producto</title>
    <link rel="stylesheet" href="~/css/tiendas.css" asp-append-version="true" />
</head>

<body>
    @if(prenda == null || prenda.IdPrenda == 0){
        <div class="subida-producto-container">
            <h2>Error</h2>
            <p>No se pudo cargar la prenda. <a href='@Url.Action("misProductos","Tienda")'>Volver a mis productos</a></p>
        </div>
    } else {
    <div class="subida-producto-container">
        <h2>Editar producto</h2>
        <form action='@Url.Action("editarPrenda","Prenda")' method="post" enctype="multipart/form-data" id="formEditarPrenda">
            <input type="hidden" name="IdPrenda" value="@prenda.IdPrenda" />
            
            <div class="form-row">
                <div class="form-group">
                    <label for="Tipo">Tipo</label>
                    <select id="Tipo" name="Tipo" class="form-select" required>
                        <option value="">Seleccionar tipo</option>
                        @if(ViewBag.tipos != null){
                            foreach(var t in ViewBag.tipos){
                                <option value="@t.idTipo" selected="@(prenda.Tipo == t.idTipo.ToString())">@t.Nombre</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="Modelo">Modelo</label>
                    <input id="Modelo" name="Modelo" type="text" placeholder="Ej: Clásico" value="@prenda.Modelo" required />
                </div>
                <div class="form-group">
                    <label>Talles disponibles</label>
                    <div class="estilos-wrap" id="tallesWrap">
                        @if(ViewBag.talles != null){
                            foreach(var t in ViewBag.talles){
                                <div>
                                    <input type="checkbox" class="talla-checkbox" name="talles" value="@t.IdTalle" id="talle_@t.IdTalle" checked="@(tallesSeleccionados.Contains(t.IdTalle))" />
                                    <label for="talle_@t.IdTalle">@t.Nombre</label>
                                </div>
                            }
                        }
                    </div>
                    <div class="small-note">Seleccioná los talles en los que estará disponible esta prenda.</div>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group" style="flex:1 1 60%">
                    <label for="descripcion">Descripción</label>
                    <textarea id="descripcion" name="descripcion" class="form-control" placeholder="Descripción de la prenda" required rows="3">@prenda.descripcion</textarea>
                </div>
                <div class="form-group" style="flex:1 1 30%">
                    <label for="Precio">Precio</label>
                    <input id="Precio" class="form-control" type="text" placeholder="100.000,23" pattern="[0-9]+([.,][0-9]+)?" value="@(prenda.Precio.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("es-AR")))" required />
                    <input type="hidden" id="PrecioHidden" name="Precio" value="@prenda.Precio" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group" style="flex:1">
                    <label>Estilos (máx 3)</label>
                    <div class="estilos-wrap">
                        @foreach(Estilo estilo in ViewBag.estilos){
                            <div>
                                <input type="checkbox" class="estilo-checkbox" name="estilos" value="@estilo.IdEstilo" id="estilo_@estilo.IdEstilo" checked="@(estilosSeleccionados.Contains(estilo.IdEstilo))" />
                                <label class="labelClaro" for="estilo_@estilo.IdEstilo">@estilo.Nombre</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="form-group" style="flex:1">
                    <label>Colores</label>
                    <div class="color-dropdown">
                        <div class="color-toggle" id="colorToggle" role="button" aria-haspopup="true" aria-expanded="@(coloresSeleccionados.Count > 0 ? "true" : "false")">Seleccionar colores <span class="small-note">(haz clic)</span></div>
                        <div class="color-menu" id="colorMenu" style="display:@(coloresSeleccionados.Count > 0 ? "block" : "none");">
                            @foreach(Color color in ViewBag.colores){
                                <label class="color-item">
                                    <input type="checkbox" class="color-checkbox" name="color" value="@color.idColor" checked="@(coloresSeleccionados.Contains(color.idColor))" />
                                    <span class="color-dot" style="background-color:@color.codigoHexa"></span>
                                    <span class="small-note">@color.Nombre</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div id="stockEditor" style="margin-top:10px;display:none">
                        <div class="small-note">Definí el stock por color y talle antes de confirmar.</div>
                        <div id="stockGrid"></div>
                    </div>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group" style="flex:1">
                    <label>Temporada</label>
                    <div>
                        @foreach(Temporada temporada in ViewBag.Temporada){
                            <input type="radio" name="Temporada" value="@temporada.idTemporada" id="temp_@temporada.idTemporada" checked="@(temporadaSeleccionada == temporada.idTemporada)" required />
                            <label class="labelClaro" for="temp_@temporada.idTemporada">@temporada.Nombre</label>
                        }
                    </div>
                </div>
            </div>
            
            <div class="form-group" style="flex:1">
                <label for="foto">Foto (dejar vacío para mantener la actual)</label>
                <input id="foto" type="file" name="foto" class="form-control" accept="image/*" />
                @if(!string.IsNullOrEmpty(prenda.foto)){
                    <div class="small-note" style="margin-top: 0.5rem;">
                        Foto actual: <img src="/img/@prenda.foto" alt="@prenda.Modelo" style="max-width: 100px; max-height: 100px; border: 1px solid #ddd; border-radius: 8px; margin-top: 0.5rem;" />
                    </div>
                }
            </div>
            
            <input type="hidden" id="variantStock" name="variantStock" value="" />
            <div class="submit-row">
                <a class="btn btn-secondary-custom" href='@Url.Action("misProductos","Tienda")'>Cancelar</a>
                <button type="submit" class="btn btn-primary-custom">Guardar cambios</button>
            </div>
        </form>
    </div>
}
    <script>
        (function(){
            // Toggle dropdown
            const toggle = document.getElementById('colorToggle');
            const menu = document.getElementById('colorMenu');
            toggle && toggle.addEventListener('click', function(e){
                const open = menu.style.display !== 'none';
                menu.style.display = open ? 'none' : 'block';
                toggle.setAttribute('aria-expanded', String(!open));
            });

            // Close when clicking outside
            document.addEventListener('click', function(e){
                if(!menu) return;
                if(!menu.contains(e.target) && !toggle.contains(e.target)){
                    menu.style.display = 'none';
                    toggle.setAttribute('aria-expanded','false');
                }
            });

            // Limit selections to 3 per group (solo para estilos)
            function limitCheckboxes(selector, max){
                const elems = document.querySelectorAll(selector);
                elems.forEach(function(chk){
                    chk.addEventListener('change', function(){
                        const checked = Array.from(document.querySelectorAll(selector)).filter(i=>i.checked);
                        if(checked.length > max){
                            this.checked = false;
                            alert('Sólo se permiten ' + max + ' selecciones.');
                        }
                    });
                });
            }
            limitCheckboxes('.estilo-checkbox', 3);
            // No hay límite para colores

            // Handle talles selection
            function getSelectedTalles(){
                return Array.from(document.querySelectorAll('.talla-checkbox')).filter(i=>i.checked).map(i=>({
                    id: parseInt(i.value), 
                    name: document.querySelector('label[for="'+i.id+'"]')?.innerText || i.value
                }));
            }

            // Build stock editor for selected colors and talles
            function rebuildStockGrid(){
                const selectedColors = Array.from(document.querySelectorAll('.color-checkbox')).filter(i=>i.checked).map(i=>({
                    id:parseInt(i.value), 
                    name: i.parentElement.querySelector('.small-note')?.innerText || i.value
                }));
                const talles = getSelectedTalles();
                const stockEditor = document.getElementById('stockEditor');
                const grid = document.getElementById('stockGrid');
                grid.innerHTML = '';
                if(selectedColors.length===0 || talles.length===0){
                    stockEditor.style.display = 'none';
                    return;
                }
                stockEditor.style.display = 'block';
                // Build table-like layout
                const table = document.createElement('div');
                table.style.display = 'grid';
                table.style.gridTemplateColumns = '200px repeat('+talles.length+', 1fr)';
                table.style.gap = '8px';
                // header
                const headerEmpty = document.createElement('div'); 
                headerEmpty.innerText = 'Color / Talle'; 
                headerEmpty.style.fontWeight='700'; 
                table.appendChild(headerEmpty);
                talles.forEach(t=>{
                    const h=document.createElement('div'); 
                    h.innerText=t.name; 
                    h.style.fontWeight='700'; 
                    table.appendChild(h);
                });
                selectedColors.forEach(color=>{
                    const colorLabel = document.createElement('div');
                    const colorCheckbox = document.querySelector('.color-checkbox[value="'+color.id+'"]');
                    const colorDot = colorCheckbox ? colorCheckbox.parentElement.querySelector('.color-dot') : null;
                    const colorHex = colorDot ? colorDot.style.backgroundColor : '#ccc';
                    const dot = document.createElement('span'); 
                    dot.className='color-dot'; 
                    dot.style.backgroundColor = colorHex;
                    colorLabel.appendChild(dot);
                    const text = document.createElement('span'); 
                    text.style.marginLeft='8px'; 
                    text.innerText = color.name; 
                    colorLabel.appendChild(text);
                    table.appendChild(colorLabel);
                    talles.forEach(t=>{
                        const inp = document.createElement('input');
                        inp.type='number'; 
                        inp.min='0'; 
                        // Cargar stock existente si está disponible
                        const stockValue = window.stockMapData && window.stockMapData[color.id] && window.stockMapData[color.id][t.id] 
                            ? window.stockMapData[color.id][t.id] 
                            : '0';
                        inp.value = stockValue; 
                        inp.dataset.color = color.id; 
                        inp.dataset.talle = t.id; 
                        inp.className='stock-input'; 
                        inp.style.width='100%'; 
                        inp.style.padding='6px'; 
                        inp.style.border='1px solid #ddd'; 
                        inp.style.borderRadius='6px';
                        table.appendChild(inp);
                    });
                });
                grid.appendChild(table);
            }

            // Cargar stockMap desde el servidor
            window.stockMapData = @Html.Raw(JsonConvert.SerializeObject(stockMap));
            
            // Construir grid inicial si hay colores y talles seleccionados
            // Esperar a que el DOM esté completamente cargado
            setTimeout(function(){
                const selectedColors = Array.from(document.querySelectorAll('.color-checkbox')).filter(i=>i.checked);
                const selectedTalles = Array.from(document.querySelectorAll('.talla-checkbox')).filter(i=>i.checked);
                if(selectedColors.length > 0 && selectedTalles.length > 0){
                    rebuildStockGrid();
                }
            }, 100);

            // wire events
            document.addEventListener('change', function(e){
                if(e.target && (e.target.classList.contains('color-checkbox') || e.target.classList.contains('talla-checkbox'))){
                    // if color selected but no talles, prompt
                    const talles = getSelectedTalles();
                    if(e.target.classList.contains('color-checkbox') && e.target.checked && talles.length===0){
                        alert('Seleccioná primero los talles disponibles.');
                        e.target.checked = false;
                        return;
                    }
                    rebuildStockGrid();
                }
            });

            // Formatear precio: convertir de formato argentino (100.000,23) a formato numérico (100000.23)
            function convertirPrecioParaEnvio(valor){
                if(!valor) return '';
                // Remover puntos (separadores de miles) y cambiar coma por punto (decimal)
                return valor.toString().replace(/\./g, '').replace(',', '.');
            }
            
            // Formatear precio para mostrar: convertir de formato numérico (100000.23) a formato argentino (100.000,23)
            function formatearPrecioParaMostrar(valor){
                if(!valor) return '';
                const num = parseFloat(valor);
                if(isNaN(num)) return valor;
                // Formatear con punto para miles y coma para decimales
                return num.toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            }
            
            // Aplicar formato al campo de precio al perder el foco
            const precioInput = document.getElementById('Precio');
            if(precioInput){
                precioInput.addEventListener('blur', function(){
                    const valor = this.value;
                    if(valor){
                        // Si tiene punto y coma, asumir formato argentino y formatear
                        if(valor.includes(',') || valor.includes('.')){
                            const num = parseFloat(convertirPrecioParaEnvio(valor));
                            if(!isNaN(num)){
                                this.value = formatearPrecioParaMostrar(num.toString());
                            }
                        }
                    }
                });
                
                precioInput.addEventListener('input', function(e){
                    // Permitir solo números, puntos y comas
                    this.value = this.value.replace(/[^0-9.,]/g, '');
                });
            }

            // Before submit: collect variant stocks into hidden input and convert price
            const form = document.getElementById('formEditarPrenda');
            form && form.addEventListener('submit', function(e){
                const anyColor = Array.from(document.querySelectorAll('.color-checkbox')).some(i=>i.checked);
                if(!anyColor){
                    e.preventDefault();
                    alert('Seleccioná al menos un color.');
                    menu.style.display = 'block';
                    toggle.setAttribute('aria-expanded','true');
                    return false;
                }
                
                // Convertir precio a formato numérico estándar
                const precioTexto = document.getElementById('Precio').value;
                if(precioTexto){
                    const precioNumerico = convertirPrecioParaEnvio(precioTexto);
                    document.getElementById('PrecioHidden').value = precioNumerico;
                }
                
                const stockInputs = Array.from(document.querySelectorAll('.stock-input'));
                const mapping = {};
                stockInputs.forEach(i=>{
                    const color = i.dataset.color; 
                    const talle = i.dataset.talle; 
                    const stock = parseInt(i.value) || 0;
                    if(!mapping[color]) mapping[color]=[];
                    mapping[color].push({talleId: parseInt(talle), stock: stock});
                });
                // mapping is {colorId: [{talleId,stock}, ...], ...}
                document.getElementById('variantStock').value = JSON.stringify(mapping);
                // allow submit to continue
            });
        })();
    </script>
    }
</body>

