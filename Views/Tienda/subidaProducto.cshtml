<head>
    <meta charset="utf-8" />
    <title>Subir producto</title>
</head>

<body>
<form action='@Url.Action("agregarPrenda","Prenda")'>

<input type="text" name="tipo" placeholder="Tipo">
<input type="text" name="Modelo" placeholder="Modelo">
<select>
<option value=1>S</option>
<option value=1>M</option>
<option value=1>L</option>
</select>
<input type="text" name="Descripcion" placeholder="Descripción">
<input type="double" name="Precio" placeholder="Precio">

<!--- PONER DESPLEGLBBLES Y ARREGLAR FORMA DE COLORES--->
@foreach(Estilo estilo in ViewBag.estilos){
    <input type="checkbox" name="estilos" value="@estilo.IdEstilo" id="@estilo.Nombre">
    <label for="@estilo.Nombre">@estilo.Nombre</label>
}
@foreach(Color color in ViewBag.colores){
    <input type="radio" name="color" value="@color.idColor" id="@color.idColor">
    <label for="@color.idColor" style="background-color:@color.codigoHexa;width:8%;border-radius:15px;margin:1%;border:1px solid black"><p style="PADDING:1%;MARGIN-TOP:2%;margin-left:10%;align-items:center;">@color.Nombre</p></label>
    //Poner que con el codigo heza se ponga el color 
}
@foreach(Temporada temporada in ViewBag.Temporada){
    <input type="radio" name="Temporada" value="@temporada.idTemporada" id="@temporada.Nombre">
    <label for="@temporada.Nombre">@temporada.Nombre</label>
}

<input type="file" name="foto">
<input type="submit" >

</form>
</body>
<script>
$('input[type=checkbox]').on('change', function (e) {
    if ($('input[type=checkbox]:checked').length > 3) {
        $(this).prop('checked', false);
        alert("allowed only 3");
    }
});</script>